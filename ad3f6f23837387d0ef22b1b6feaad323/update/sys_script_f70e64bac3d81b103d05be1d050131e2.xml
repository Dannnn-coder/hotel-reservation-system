        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // Find all reservations linked to the room being updated
    var grRes = new GlideRecord('x_2206701_hotel_0_scheduled_reservations');
    grRes.addQuery('room', current.sys_id);
    grRes.query();
    
    while (grRes.next()) {
        // Fire the custom event and pass the guest's email as Parameter 1
        gs.eventQueue('x_2206701_hotel_0.room.changed', current, grRes.guest_email.toString(), '');
    }
})(current, previous);]]></script>

        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    var checkInStr = current.getValue('check_in_date');
    if (!checkInStr) return;
    var checkIn = new GlideDateTime();
    checkIn.setValue(checkInStr + ' 00:00:00');
    var now = new GlideDateTime();
    var hoursUntil = (checkIn.getNumericValue() - now.getNumericValue()) / (1000 * 60 * 60);
    if (hoursUntil < 72) {
        gs.addErrorMessage('Cancellation is only allowed 72 hours before check-in.');
        current.setAbortAction(true);
    }
})(current, previous);]]></script>

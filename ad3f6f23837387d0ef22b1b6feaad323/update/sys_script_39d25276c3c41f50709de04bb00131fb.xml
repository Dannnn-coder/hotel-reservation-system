        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    var ru = new x_2206701_hotel_0.ReservationUtils();

    var checkIn = current.getValue('check_in_date');
    var checkOut = current.getValue('check_out_date');

    // Auto-calculate number of days + total when both dates are set
    if (checkIn && checkOut) {
        var nights = ru.calculateDays(checkIn, checkOut);
        current.setValue('number_of_days', nights);

        // Total = fallback (rate * nights). Swap for Role 4's pricing later.
        var total = ru._fallbackPrice(current.getValue('room'), nights);
        current.setValue('total_payment', total);
    }

})(current, previous);
]]></script>

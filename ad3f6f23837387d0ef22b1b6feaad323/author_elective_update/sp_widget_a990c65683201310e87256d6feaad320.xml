<?xml version="1.0" encoding="UTF-8"?><record_update table="sp_widget">
    <sp_widget action="DELETE">
        <category>custom</category>
        <client_script><![CDATA[api.controller=function($window) {
    var c = this;
    var currentPath = $window.location.pathname;
    var searchParam = $window.location.search;
    var skip = searchParam.indexOf('noredirect=true') !== -1;
    
    // Check session storage to ensure we only auto-redirect once per session
    var alreadyRedirected = $window.sessionStorage.getItem('hotel_portal_redirected');
    
    // Check if we are already on the target hotel page or inside the portal path
    var isAlreadyAtDestination = searchParam.indexOf('hotel_reservation_home_page') !== -1;
    
    if (c.data.redirectUrl && !skip && !isAlreadyAtDestination && !alreadyRedirected) {
        // Set the flag to block subsequent loop triggers
        $window.sessionStorage.setItem('hotel_portal_redirected', 'true');
        
        // Execute the browser redirect
        $window.location.href = c.data.redirectUrl;
    }
};]]></client_script>

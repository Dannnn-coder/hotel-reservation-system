        <name>Hotel Staff Redirect</name>
        <option_schema/>
        <public>false</public>
        <roles/>
        <script><![CDATA[(function() {
    data.redirectUrl = '';
    
    if (gs.isLoggedIn()) {
        var isRegisteredUser = gs.hasRole('x_2206701_hotel_0.registered_user');
        var isAdminOrItil = gs.hasRole('admin') || gs.hasRole('itil');
        
        if (isAdminOrItil) {
            data.redirectUrl = '/now/nav/ui/home';
        }
        else if (isRegisteredUser) {
            // Point straight to the portal page route to ensure the header widget renders
            data.redirectUrl = '/sp?id=hotel_reservation_home_page';
        }
    }
})();]]></script>
